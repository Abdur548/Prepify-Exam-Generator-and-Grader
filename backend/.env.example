# Copy to `.env` and fill in your values. `.env` and every `.env.*` variant are
# ignored; this template is the one exception and must never gain a real value.

# Required. The only credential the system holds. It is read from the environment
# and never logged, never returned by an endpoint and never put in a URL (S1) —
# `llm/client.py` redacts anything key-shaped before a message reaches a log.
GEMINI_API_KEY=AIza...

# REPORTED, NOT ENFORCED. `eval/__main__.py` prints this number and `LLMClient`
# stores it, but nothing compares a running call count against it, so setting it
# does not stop a run. Measured 2026-09-06: one assignment, zero comparisons.
# Treat it as documentation of the intended budget until a check exists.
PER_DAY_CALL_CAP=900

# Leave unset. `=1` opens the one `/api/internal/*` route there is —
# `POST /api/internal/reset-disclosure`, which clears the disclosure flag without
# authentication so a browser test can put the app back to a known state. Read
# per-request, so setting it on a running server takes effect immediately; any
# value other than the exact string `1` keeps the route closed (404).
# PREPIFY_TEST_SEAMS=1
